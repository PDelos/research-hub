{
  "name": "research-hub",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Research Hub: per-project durable agents that find, judge and keep academic papers. The npm workspace root.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "vp check && npm run typecheck --workspaces --if-present && npm run check:jev && npm run check:env",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check:env": "node scripts/check-env.mjs",
    "check:jev": "tsx packages/jev/scripts/check-lock.ts apps/rh-server/prompt_engineering/jev",
    "lock:jev": "tsx packages/jev/scripts/check-lock.ts apps/rh-server/prompt_engineering/jev --update"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-plus": "^1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  }
}
