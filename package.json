{
  "name": "research-hub",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Research Hub: per-project durable agents that find, judge and keep academic papers. The npm workspace root.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "oxlint packages apps",
    "fmt": "oxfmt -c config/.oxfmtrc.json packages apps",
    "fmt:check": "oxfmt --check -c config/.oxfmtrc.json packages apps",
    "check:env": "node scripts/check-env.mjs",
    "check:jev": "tsx packages/jev/scripts/check-lock.ts apps/rh-server/prompt_engineering/jev",
    "lock:jev": "tsx packages/jev/scripts/check-lock.ts apps/rh-server/prompt_engineering/jev --update"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
