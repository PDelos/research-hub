# Copy to .env (or let ./new-project.sh write it). Never commit .env.

# The one research project this container serves: lowercase letters, digits and dashes, at most 40 characters.
# It names the compose project (rh-<name>), the page title, health and every log line, and the browser address
# http://<name>.localhost:<RH_PUBLISH_PORT>.
RH_PROJECT_NAME=research

# Mode: live (real models and Jev through OpenRouter) or offline (fake model + mock Jev, no network).
RH_MODE=live

# OpenRouter key: all models, embeddings and Jev. Required in live mode.
# Use one key per project and set a credit limit on it at openrouter.ai, so projects cannot spend each other's budget.
OPENROUTER_API_KEY=

# Bearer tokens. RH_API_TOKEN guards the API; RH_CLIENT_TOKEN is held by the built-in UI proxy and never
# reaches the browser. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RH_API_TOKEN=
RH_CLIENT_TOKEN=

# Server
RH_PORT=4850
# 127.0.0.1 locally; the Docker image sets 0.0.0.0 inside the container (compose publishes it on 127.0.0.1 only).
RH_HOST=127.0.0.1
RH_DATA_DIR=./data
RH_LOG_LEVEL=info
# Extra host names the built-in UI may be opened from (comma separated), besides localhost and 127.0.0.1.
RH_ALLOWED_HOSTS=
# Where the built UI lives (default: apps/rh-client-browser/dist).
# RH_UI_DIR=
# Which .env file the server loads (default: the repo root .env; "none" to skip).
# RH_ENV_FILE=

# Models per job (OpenRouter IDs). Change here to switch models; no code changes needed.
RH_MODEL_DESK=anthropic/claude-haiku-5.5
RH_MODEL_READER=anthropic/claude-haiku-5.5
RH_MODEL_REVIEW=anthropic/claude-sonnet-5.5
RH_MODEL_CHAT=anthropic/claude-haiku-5.5
RH_MODEL_JEV=typesafe/jev-1.14

# Paper representations: one embedding model for every paper (OpenRouter ID) and its vector size. Changing either
# re-embeds the project's papers in the background; vectors from different models are never compared.
RH_MODEL_EMBED=qwen/qwen3-embedding-8b
RH_EMBED_DIMS=1024

# Paper sources (arXiv, OpenAlex, Europe PMC need no keys). Your email is sent to OpenAlex and Europe PMC so they
# put requests in their polite pools; without it the hub warns once at startup and still works.
CONTACT_EMAIL=
# Optional: Semantic Scholar is used only with a key (its keyless pool is rate limited).
S2_API_KEY=

# Docker (compose only): the host port this project is published on (127.0.0.1 only), its data folder and limits.
RH_PUBLISH_PORT=4850
# RH_HOST_DATA_DIR=./data
RH_MEM_LIMIT=2g
RH_CPUS=2

# Schedule (the daily cycle): time zone (IANA name), daily sweep time (new-project.sh staggers projects 20 minutes
# apart), the nightly run (the cycle's analysis slot) and the weekly digest ("<sun..sat> HH:MM"). Changes saved in
# the UI's Settings tab take precedence over these defaults.
RH_TIMEZONE=UTC
RH_SWEEP_TIME=06:00
RH_NIGHTLY_TIME=02:00
RH_REVIEW_TIME=sun 07:00

# Knowledge base viewer: the real Obsidian interface for this project's vault, inside the hub (Knowledge base tab).
# It runs in this container (Ignis, pinned), listens on 127.0.0.1 only and is reached through the hub at /kb/.
# On first start the hub downloads the pinned Obsidian package (about 9 MB) from Obsidian's official release.
# off disables it; the Library tab still lists and opens every note.
RH_KB_VIEWER=on
# Where Ignis is installed (the image puts it at /opt/ignis; for local development point at a checkout of
# https://github.com/Nystik-gh/ignis at tag v0.8.18+obsidian.1.14.4, built with npm ci && npm run build).
# RH_KB_VIEWER_DIR=/opt/ignis
# The Obsidian version Ignis is pinned to; change only together with the Ignis release.
# RH_KB_OBSIDIAN_VERSION=1.14.4

# Full text (v1.6): PDFs are turned into sections by the active converter (Plugins → Converter slot). The core image
# has the light pdf.js converter; the research-hub:full image adds Docling (layout, reading order, tables), which runs
# as a local process when RH_DOCLING=on (set by that image). Or point RH_DOCLING_URL at a Docling Serve you run.
# RH_DOCLING=off
# RH_DOCLING_URL=http://127.0.0.1:5001
# RH_DOCLING_PORT=5001
# RH_DOCLING_CMD=docling-serve
# How often the hub asks Docling whether a conversion is done (ms), and how long Docling Serve lets one wait (s).
# RH_DOCLING_POLL_MS=2000
# DOCLING_SERVE_MAX_SYNC_WAIT=600
