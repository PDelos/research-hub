{
  "name": "rh-server",
  "private": true,
  "description": "Research Hub server: project agents, Jev, API, live stream and the built UI on one port",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p .",
    "pack": "vp pack"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@electron/asar": "^4.3.1",
    "@rh/durable-agent": "*",
    "@rh/jev": "*",
    "@rh/sdk": "*",
    "ajv": "^8.20.0",
    "express": "5.3.0",
    "fast-xml-parser": "^5.11.2",
    "hyparquet": "1.31.5",
    "hyparquet-compressors": "1.1.2",
    "isomorphic-git": "^1.44.4",
    "semver": "^7.8.5",
    "sqlite-vec": "0.1.9",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/semver": "^7.8.0",
    "hyparquet-writer": "0.17.0"
  }
}
