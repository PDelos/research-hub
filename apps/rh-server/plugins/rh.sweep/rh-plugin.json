{
  "id": "rh.sweep",
  "version": "1.0.0",
  "displayName": "Daily sweep and cards",
  "kind": "core",
  "topic": "finding",
  "description": "The daily sweep: gathers papers for the charter's questions, gates and ranks them with Jev, and writes the day's cards (Relevance, Trust, Value).",
  "engines": {
    "research-hub": "^1.0.0"
  },
  "main": "main.ts",
  "required": true,
  "activationEvents": ["onStartup"],
  "dependencies": {
    "rh.provider-openrouter": "^1.0.0",
    "rh.decision-jev": "^1.0.0",
    "rh.papers": "^1.0.0",
    "rh.charter": "^1.0.0",
    "rh.schedule": "^1.0.0",
    "rh.feedback": "^1.0.0"
  },
  "contributes": {
    "tabs": [
      {
        "id": "feed",
        "title": "Feed",
        "view": "feed",
        "order": 10
      }
    ],
    "jevCommands": [
      "../../prompt_engineering/jev/worth-reading",
      "../../prompt_engineering/jev/importance",
      "../../prompt_engineering/jev/level",
      "../../prompt_engineering/jev/on-theme",
      "../../prompt_engineering/jev/paper-kind"
    ],
    "prompts": [
      {
        "agent": "card-writer",
        "path": "../../prompt_engineering/agents/card-writer"
      }
    ],
    "settings": {
      "properties": {
        "cardsPerSweep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15,
          "default": 7,
          "description": "Cards each sweep presents."
        },
        "explorationPicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "Card slots given to papers least like the ones you liked (0 turns exploration off)."
        },
        "relevanceMin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Gate: reject papers less relevant than this (default: the on-theme command's 0.45)."
        },
        "worthMin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Gate: reject papers less worth reading than this (default: the worth-reading command's 0.35)."
        },
        "rankWeights": {
          "type": "object",
          "description": "Rank formula weights (default importance 0.4, relevance 0.2, question 0.15, level 0.15, freshness 0.1).",
          "required": ["importance", "relevance", "question", "level", "freshness"],
          "additionalProperties": false,
          "properties": {
            "importance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "relevance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "question": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "freshness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
