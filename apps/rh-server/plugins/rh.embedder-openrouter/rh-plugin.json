{
  "id": "rh.embedder-openrouter",
  "version": "1.0.0",
  "displayName": "OpenRouter embeddings",
  "kind": "slot",
  "topic": "understanding",
  "slot": "embedder",
  "description": "Embeds papers with an OpenRouter embedding model (RH_EMBED_MODEL, RH_EMBED_DIMS); offline, a deterministic local stand-in.",
  "engines": {
    "research-hub": "^1.0.0"
  },
  "main": "main.ts",
  "required": true,
  "activationEvents": ["onExtensionPoint:papers.embedder"],
  "contributes": {
    "papers.embedder": [
      {
        "id": "openrouter",
        "title": "OpenRouter embeddings"
      }
    ],
    "settings": {
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[\\w.:-]+$",
          "description": "OpenRouter embedding model (default: RH_MODEL_EMBED). Changing it re-embeds every paper in the background."
        },
        "dims": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4096,
          "description": "Vector size (default: RH_EMBED_DIMS)."
        }
      }
    }
  },
  "permissions": {
    "network": ["openrouter.ai"],
    "secrets": ["OPENROUTER_API_KEY"]
  }
}
