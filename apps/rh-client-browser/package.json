{
  "name": "rh-client-browser",
  "private": true,
  "description": "Research Hub web client (Vue 3). Built into dist/ and served by rh-server on the same port.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "check": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rh/sdk": "*",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
