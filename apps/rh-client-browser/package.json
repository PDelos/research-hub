{
  "name": "rh-client-browser",
  "private": true,
  "description": "Research Hub web client (Vue 3). Built into dist/ and served by rh-server on the same port.",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit -p tsconfig.json && vp build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@rh/sdk": "*",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "vite-plus": "1.4.0",
    "vue-tsc": "3.3.13"
  }
}
