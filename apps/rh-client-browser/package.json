{
  "name": "rh-client-browser",
  "private": true,
  "description": "Research Hub web client (Vue 3). Built into dist/ and served by rh-server on the same port.",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit -p tsconfig.json && vp build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "test:ui": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rh/sdk": "*",
    "@vitejs/plugin-vue": "6.0.10",
    "pinia": "4.1.0",
    "vite-plus": "1.4.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13"
  }
}
